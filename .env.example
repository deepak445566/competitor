# Copy to .env and fill in.

# --- Admin login (single admin, no registration) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Signs the login cookie. Any long random string (optional: derived from the password if empty).
SESSION_SECRET=

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/competitor-monitor   # or mongodb+srv://<user>:<password>@<cluster>/competitor-monitor

# --- Crawler ---
CRAWL_MAX_PAGES=50          # default page limit per competitor (editable per competitor)
MAX_CONCURRENT_CHECKS=2     # competitors checked at the same time; others wait their turn
CRAWL_CONCURRENCY=3         # pages loaded in parallel (1 if robots.txt sets Crawl-delay)
CRAWL_TIMEOUT_MS=30000
CRAWLER_ENGINE=playwright   # playwright = fast HTTP + Chromium only for JS-built/blocked pages | fetch = HTTP only
# CRAWLER_USER_AGENT=   # default: desktop Chrome (bot user agents get blocked by many sites)

# --- Scheduling ---
CHECK_INTERVAL_HOURS=24     # automatic re-check interval; 0 = only manual "Check now"
WATCH_INTERVAL_MINUTES=30   # quick sitemap check for brand-new blogs/products; 0 = off
SNAPSHOT_RETENTION=3        # snapshots that keep full page data
# Every RETENTION_DAYS days, data older than RETENTION_DAYS is saved as CSV in ARCHIVE_DIR, then deleted from MongoDB (0 = keep everything)
RETENTION_DAYS=7
ARCHIVE_DIR=archives
# Optional external trigger: GET /api/cron with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Display ---
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:3000   # used for links in emails

# --- Email notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
NOTIFY_EMAIL=
